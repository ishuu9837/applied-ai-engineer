{
  "name": "applied-ai-engineer-bootcamp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Zero-dependency static interactive bootcamp with five-day staged releases",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "release": "node scripts/release.mjs",
    "preview": "node scripts/build.mjs --preview && node scripts/serve.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

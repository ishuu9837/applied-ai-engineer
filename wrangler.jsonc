{
  "name": "applied-ai-engineer",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "applied-ai-academy",
      "database_id": "154d181e-9000-4f3b-a140-02dddce3f644"
    }
  ]
  // R2 is optional. Once the bucket exists, add an ARTIFACTS binding.
}
